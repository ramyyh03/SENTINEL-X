# ───────────────────────────────────────────────
# SENTINEL-X — .gitignore (Python + Node + macOS + Windows + Docker)
# ───────────────────────────────────────────────

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
.venv/
env/
*.egg-info/
.pytest_cache/

# --- Secrets & config locale (JAMAIS en Git) ---
.env
.env.local
*.pem
*.key
*.crt
# Tokens GitHub (jamais committés)
.github-token
.github-token.txt
*-token.txt

# --- Test matériel (sorties runtime par machine) ---
data/captures/
RAPPORT-MATERIEL.md

# --- Base de données (créée au runtime) ---
sentinel.db
*.sqlite
*.sqlite3
data/*.db
data/*.db-journal

# --- Logs ---
*.log
logs/

# --- Modèles IA entraînés (binaires régénérables via `make train`) ---
models/
# Poids YOLO (téléchargés automatiquement par ultralytics)
*.pt

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride

# --- Windows ---
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Node / Front (Dashboard DEV) ---
node_modules/
dist/
build/
.npm/

# --- Docker (volumes locaux) ---
docker/data/
docker/mosquitto/data/
docker/mosquitto/log/

# --- Firmware ESP32 / PlatformIO (build + libs régénérables) ---
firmware/.pio/
firmware/.vscode/.browse.c_cpp.db*
firmware/.vscode/c_cpp_properties.json
firmware/.vscode/launch.json
firmware/.vscode/ipch/
# Identifiants en dur (si quelqu'un en ajoute) — JAMAIS committés
secrets.h
**/secrets.h

# --- IDE ---
.vscode/
.idea/
*.swp
docker/mosquitto/config/passwd

*.srl
