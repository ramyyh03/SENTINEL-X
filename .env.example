# ───────────────────────────────────────────────
# SENTINEL-X — Exemple de configuration
# Copier ce fichier en « .env » et remplir les valeurs.
# NE JAMAIS committer le vrai .env (il est dans .gitignore).
# ───────────────────────────────────────────────

# --- Broker MQTT (Mosquitto sur le PC Windows) ---
MQTT_HOST=192.168.x.x
MQTT_PORT=1883
MQTT_USER=sentinel
MQTT_PASSWORD=<à remplir>
MQTT_TOPIC=sentinel/sensors

# --- API DEV (réception des alertes) ---
API_URL=http://localhost:3000
API_ALERTS_ENDPOINT=/api/v1/alerts

# --- Vision IA (YOLOv8) ---
YOLO_CONFIDENCE=0.5

# --- Prédictif (Isolation Forest) ---
ISOLATION_FOREST_CONTAMINATION=0.05

# --- Base de données ---
SQLITE_PATH=sentinel.db
