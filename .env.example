# ───────────────────────────────────────────────
# SENTINEL-X — Exemple de configuration
# Copier ce fichier en « .env » et remplir les valeurs.
# NE JAMAIS committer le vrai .env (il est dans .gitignore).
# ───────────────────────────────────────────────

# --- Broker MQTT ---
# DEV local (broker docker-compose.dev.yml) : host=localhost, port=1883, anonyme
# PROD (PC Windows, TLS) : host=192.168.x.x, port=8883 + MQTT_CA_CERT
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=sentinel
MQTT_PASSWORD=sentinel
MQTT_TOPIC=sentinel/sensors
# Certificat CA (seulement pour le port TLS 8883, prod)
MQTT_CA_CERT=docker/mosquitto/certs/ca.crt
# --- Signature HMAC anti-injection (OPTIONNEL) ---
# Vide = désactivé (démo rétrocompatible). Si renseigné, DOIT être identique à
# SENTINEL_HMAC_SECRET dans firmware/include/secrets.h (flasher avec -DUSE_HMAC).
# Un faux message (sans la clé) est alors rejeté automatiquement.
MQTT_HMAC_SECRET=
# true = rejette aussi les messages SANS signature (prod, tous les ESP32 signent).
# false = souple : on accepte les messages non signés, on bloque les faux signés.
MQTT_HMAC_STRICT=false

# --- API DEV / BRIQUE 7 (réception des alertes) ---
API_URL=http://localhost:3000
API_ALERTS_ENDPOINT=/api/v1/alerts
API_HOST=127.0.0.1       # 127.0.0.1 = local seulement (sécurité) ; 0.0.0.0 = exposé LAN
API_PORT=3000
API_RATE_MAX=100         # requêtes max par IP…
API_RATE_WINDOW=60       # …par fenêtre (secondes)
# Auth dashboard : clé de session (optionnelle — sinon générée/persistée dans data/.flask_secret)
# FLASK_SECRET_KEY=change-moi-par-une-longue-chaine-aleatoire

# --- Vision IA (YOLOv8 / BRIQUE 5) ---
YOLO_CONFIDENCE=0.5
CAMERA_INDEX=0        # 0 = 1re caméra ; webcam USB (UGREEN CM678) souvent 1 sur un PC à caméra intégrée

# --- Prédictif / BRIQUE 6 (Isolation Forest + LOF) ---
ISOLATION_FOREST_CONTAMINATION=0.05
FOREST_CONTAMINATION=0.1          # % d'anomalies attendues (entraînement)
FOREST_THRESHOLD=0.4              # score >= seuil => alerte (0.4 = tous les incidents captés)
LOF_NEIGHBORS=20                  # voisins du Local Outlier Factor
ALERT_WINDOW=300                 # fenêtre (s) pour l'escalade (3+ anomalies => CRITICAL)
ALERT_MIN_INTERVAL=60            # anti-spam : 1 alerte/min max (coalescence)
GENERATE_SYNTHETIC_DATA=true     # (re)générer les données synthétiques à l'entraînement
ARIMA_ENABLED=false              # prévision ARIMA (optionnel, nécessite statsmodels)
API_ENDPOINT=http://localhost:3000/api/v1/alerts  # cible POST des alertes IA

# --- Base de données (SQLite local, pas d'authentification — fichier local) ---
DB_PATH=data/sentinel.db
