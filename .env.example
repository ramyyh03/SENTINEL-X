# ───────────────────────────────────────────────
# SENTINEL-X — Exemple de configuration
# Copier ce fichier en « .env » et remplir les valeurs.
# NE JAMAIS committer le vrai .env (il est dans .gitignore).
# ───────────────────────────────────────────────

# --- Broker MQTT ---
# DEV local (broker docker-compose.dev.yml) : host=localhost, port=1883, anonyme
# PROD (PC Windows, TLS) : host=192.168.x.x, port=8883 + MQTT_CA_CERT
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=sentinel
MQTT_PASSWORD=sentinel
MQTT_TOPIC=sentinel/sensors
# Certificat CA (seulement pour le port TLS 8883, prod)
MQTT_CA_CERT=mosquitto/certs/ca.crt

# --- API DEV (réception des alertes) ---
API_URL=http://localhost:3000
API_ALERTS_ENDPOINT=/api/v1/alerts

# --- Vision IA (YOLOv8) ---
YOLO_CONFIDENCE=0.5

# --- Prédictif (Isolation Forest) ---
ISOLATION_FOREST_CONTAMINATION=0.05

# --- Base de données (SQLite local, pas d'authentification — fichier local) ---
DB_PATH=data/sentinel.db
