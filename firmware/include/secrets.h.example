#define WIFI_SSID     "Don't use AI man"      // nom de ton réseau WiFi
#define WIFI_PASSWORD "mot_de_passe_wifi"      // mot de passe du WiFi
#define BROKER_IP     "192.168.43.45"          // IP du PC qui fait tourner le broker

// --- Signature HMAC anti-injection (OPTIONNEL, flasher avec -DUSE_HMAC) -----
// Doit être EXACTEMENT la même valeur que MQTT_HMAC_SECRET dans le .env du PC.
// Un attaquant qui ne connaît pas cette clé ne peut pas injecter de faux message.
#define SENTINEL_HMAC_SECRET "change-moi-cle-partagee-equipe-6"
